          "case_id": {
            "type": "string",
            "pattern": "^SR3D_[a-fA-F0-9]{8,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^TR3DI_[a-fA-F0-9]{8,32}$"
          },
          "source_fingerprint": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "source_category": {
            "enum": [
              "medical_scalar",
              "grayscale_8bit",
              "rgb"
