{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satorumuro.github.io/SegRef3D/schemas/trainref3d-evaluation-certificate-1.0.schema.json",
  "title": "EvalRef3D v1 self-evaluated research record",
  "type": "object",
  "properties": {
    "format": {
      "const": "trainref3d-evaluation-certificate-1.0"
    },
    "certificate_id": {
      "type": "string",
      "pattern": "^TR3DE_[a-fA-F0-9]{8,32}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "type": "object",
      "properties": {
        "level": {
          "const": "self_evaluated",
          "description": "Reserved future levels: platform_verified, externally_validated. v1 emitters accept self_evaluated only."
        },
        "platform_signature": {
          "type": "null"
        }
      },
      "required": [
        "level",
        "platform_signature"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^TR3DM_[a-fA-F0-9]{8,32}$"
        },
        "model_zip_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_format": {
          "const": "trainref3d-model-1.0"
        },
        "type": {
          "const": "binary_segmentation"
        },
        "target_label_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "target_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "input": {
          "type": "object"
        },
        "preprocessing": {
          "type": "object"
        },
        "model_manifest": {
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_zip_sha256",
        "model_format",
        "type",
        "target_label_id",
        "target_name",
        "input",
        "preprocessing",
        "model_manifest"
      ],
      "additionalProperties": false
    },
    "evaluation_set": {
      "type": "object",
      "properties": {
        "role": {
          "const": "independent_holdout"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "case_id_overlap_with_training": {
          "const": false
        },
        "subject_independence": {
          "type": "object",
          "properties": {
            "status": {
              "const": "user_attested"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "ground_truth_complete": {
          "const": "user_attested"
        },
        "platform_verified_subject_independence": {
          "const": false
        }
      },
      "required": [
        "role",
        "case_count",
        "domain",
        "case_id_overlap_with_training",
        "subject_independence",
        "ground_truth_complete",
        "platform_verified_subject_independence"
      ],
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "properties": {
        "source": {
          "const": "InferRef3D raw prediction"
        },
        "postprocessing": {
          "const": "none"
        },
        "human_edit": {
          "const": false
        }
      },
      "required": [
        "source",
        "postprocessing",
        "human_edit"
      ],
      "additionalProperties": false
    },
    "metrics_definition": {
      "const": {
        "version": "evalref3d-metrics-1.0",
        "foreground": "label == model.target_label_id",
        "dice": "2*TP/(GT+prediction); both empty=1",
        "iou": "TP/(GT+prediction-TP); both empty=1",
        "precision": "TP/prediction; prediction empty=null",
        "recall": "TP/GT; GT empty=null",
        "volume_mm3": "voxel_count * abs(det(full_affine[:3,:3]))",
        "volume_error_percent": "(prediction-GT)/GT*100; GT empty=null",
        "absolute_volume_error_percent": "abs(volume_error_percent)",
        "surface": "foreground voxel with at least one background or outside-volume 6-connected neighbor",
        "surface_coordinates": "voxel centers (integer IJK), full affine to world RAS mm",
        "surface_distances": "concatenated GT-to-prediction and prediction-to-GT Euclidean nearest surface center distances",
        "hd95_mm": "numpy.percentile(combined_distances,95,method=linear)",
        "assd_mm": "mean(combined_distances); weighted by total surface voxel count",
        "empty_surface_policy": "either mask empty: hd95_mm=null, assd_mm=null",
        "empty_masks": {
          "both_empty": {
            "dice": 1,
            "iou": 1,
            "precision": null,
            "recall": null
          },
          "gt_empty": {
            "dice": 0,
            "iou": 0,
            "precision": 0,
            "recall": null
          },
          "prediction_empty": {
            "dice": 0,
            "iou": 0,
            "precision": null,
            "recall": 0
          }
        },
        "aggregation": "unweighted per-case; null excluded; population standard deviation ddof=0",
        "geometry": {
          "absolute_tolerance": 1e-05,
          "relative_tolerance": 0,
          "resampling": false
        }
      }
    },
