{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satorumuro.github.io/SegRef3D/schemas/instant3d_request.schema.json",
  "title": "SegRef3D Seg CT/MRI request",
  "type": "object",
  "required": ["schema", "schema_version", "request_id", "source", "objects", "options"],
  "properties": {
    "schema": {"const": "segref3d-instant3d-bridge"},
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 8},
    "source": {
      "type": "object",
      "required": ["filename", "modality", "shape", "voxel_spacing_mm", "orientation", "affine", "sha256"],
      "properties": {
        "filename": {"enum": ["source.nii", "source.nii.gz"]},
        "modality": {"const": "CT"},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 3, "maxItems": 3},
        "voxel_spacing_mm": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
        "orientation": {"type": "string", "minLength": 3, "maxLength": 3},
        "affine": {"type": "array", "minItems": 4, "maxItems": 4},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "objects": {"type": "array", "minItems": 1, "maxItems": 20},
    "options": {"type": "object"}
  }
}
